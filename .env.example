# --- Server ---
# development untuk http lokal.
NODE_ENV=development
PORT=3000
# Alamat aplikasi dibuka (pakai 127.0.0.1, bukan localhost).
APP_ORIGIN=http://127.0.0.1:3000
# Secret sesi, minimal 32 byte acak. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK

# --- Blockchain lokal (Hardhat, chain ID 31337) ---
RPC_URL=http://127.0.0.1:8545
# Harus sama dengan CONTRACT_ADDRESS di frontend/js/config.js.
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# --- Database aplikasi ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hospital_app
DB_PASSWORD=
DB_NAME=hospital_dapp

# --- Reset database (dipakai start.bat) ---
# Menghapus semua data lalu mengisi data contoh. Hanya untuk lokal.
DB_RESET_USER=hospital_reset
# Sama dengan password hospital_reset di database/users.sql.
DB_RESET_PASSWORD=
