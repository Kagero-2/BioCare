# Salin menjadi .env lalu sesuaikan. File .env TIDAK di-commit.

# --- Server ---
# development: cookie sesi tanpa flag Secure (http lokal). Selain itu dianggap production (cookie Secure).
NODE_ENV=development
PORT=3000
# Origin tempat aplikasi DIBUKA di browser, persis (skema + host + port, tanpa / di akhir).
# Semua POST/PUT/PATCH/DELETE wajib header Origin yang sama, dan pesan login SIWE memakai host ini.
# Selalu buka aplikasi lewat alamat ini (127.0.0.1, BUKAN localhost) agar Origin & domain SIWE cocok.
APP_ORIGIN=http://127.0.0.1:3000
# Kunci HMAC untuk JWT sesi (minimal 32 byte, acak). Server MENOLAK start jika kosong, < 32 byte,
# atau masih sama dengan placeholder ini. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK

# --- Blockchain lokal (Hardhat Network, chainId 31337) ---
RPC_URL=http://127.0.0.1:8545
# Alamat deploy pertama akun #0 Hardhat. Harus sama dengan CONTRACT_ADDRESS di frontend/js/config.js.
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# --- Database MySQL (user khusus aplikasi dari database/users.sql, BUKAN root) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hospital_app
# Sama dengan password yang kamu tulis di database/users.sql sebelum dijalankan.
DB_PASSWORD=
DB_NAME=hospital_dapp

# --- Reset database dev (dipakai start.bat dan scripts/dev-db.js) ---
# PERINGATAN: reset MENGHAPUS semua data di database hospital_dapp lalu mengisinya dengan data contoh.
# Jangan isi di server sungguhan.
# User khusus hospital_reset dari database/users.sql (hak INSERT + DROP di hospital_dapp saja), BUKAN root:
# ganti placeholder password hospital_reset di users.sql, jalankan sebagai root, lalu tulis password yang sama di sini
# (setup.bat melakukannya otomatis).
# Reset MENOLAK jalan jika user kosong/root, password kosong, NODE_ENV bukan development, DB_NAME bukan
# hospital_dapp, atau DB_HOST bukan lokal (scripts/dev-db.js). Kredensial root tidak pernah ditulis di .env.
DB_RESET_USER=hospital_reset
DB_RESET_PASSWORD=
